{
  "compilerOptions": {
    // 코어(`borch`)와 같은 설정이다. 갈리면 코어에서 통과한 코드가 여기서 안 되거나
    // 그 반대가 되는데, 그 차이는 컴파일러가 아니라 사용자가 발견하게 된다.
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",

    // 코어는 `borch-ts` 라는 이름으로 npm 에 있다. 전에는 옆에 나란히 받아둔 코어의
    // 선언 파일을 `paths` 로 빌렸는데, 그 두 줄과 그것을 런타임에서 흉내 내던 해석기
    // 훅이 **설치된 것 하나로 대체됐다.** 타입도 값도 같은 자리에서 온다.
    "lib": ["ES2022", "DOM"],
    // WebGPU 타입은 아직 TypeScript 의 기본 DOM 라이브러리에 없다. 코어의 선언
    // 파일이 `GPUBuffer` 같은 이름을 그대로 쓰므로, 없으면 **코어를 읽는 자리에서**
    // 컴파일이 멈춘다 — 우리 코드가 WebGPU 를 직접 안 만져도 필요하다.
    // `node` 는 test/ 가 node:test 를 쓰기 때문이다.
    "types": ["@webgpu/types", "node"],
    "outDir": "dist",
    "rootDir": ".",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "declaration": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
